// Recursos do ie3.exe: ícone, manifesto e dados de versão (aparecem em Propriedades > Detalhes)
#include <winver.h>
#define IE3_VER 0,1,0,0
#define IE3_VER_STR "0.1.0"

1 ICON "ie3.ico"
1 24 "ie3.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION IE3_VER
PRODUCTVERSION IE3_VER
FILEFLAGSMASK 0x3fL
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604b0"
    BEGIN
      VALUE "CompanyName", "inazumaEleven3Recomp (projeto de fãs)"
      VALUE "FileDescription", "Inazuma Eleven 3 Recomp"
      VALUE "FileVersion", IE3_VER_STR
      VALUE "InternalName", "ie3"
      VALUE "LegalCopyright", "Projeto de fãs sem fins lucrativos. Inazuma Eleven é da LEVEL-5."
      VALUE "OriginalFilename", "ie3.exe"
      VALUE "ProductName", "Inazuma Eleven 3 Recomp"
      VALUE "ProductVersion", IE3_VER_STR
      VALUE "Comments", "Recompilação estática não oficial. Precisa da sua própria ROM."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
